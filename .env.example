# External IBM AMLworld HI-Small CSV. Used only by offline preparation.
IBM_HI_SMALL_TRANSACTIONS_PATH=/absolute/path/to/HI-Small_Trans.csv

# Deterministic V2 runtime paths.
TRAILSIGHT_V2_DB_PATH=data/v2/runtime/trailsight_v2.duckdb
TRAILSIGHT_RUNTIME_STATE_PATH=data/state/runtime_state.json
TRAILSIGHT_TRACE_PATH=data/traces/investigations-v2.jsonl

# Optional AI. Both values must be non-empty for /api/v2/health to report configured.
# Keep the real API key only in the untracked local .env file.
OPENAI_API_KEY=
TRAILSIGHT_MODEL=
TRAILSIGHT_PROMPT_VERSION=investigation-v2

# Optional telemetry cost estimation.
TRAILSIGHT_MODEL_INPUT_USD_PER_MILLION=
TRAILSIGHT_MODEL_OUTPUT_USD_PER_MILLION=
